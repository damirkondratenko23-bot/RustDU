[package]
name = "rustdu"
version = "0.1.0"
edition = "2021"
description = "Терминальный анализатор дискового пространства (аналог ncdu на Rust)"
authors = ["Damir <your-email@example.com>"]
license = "MIT"
repository = "https://github.com/yourname/rustdu"

[dependencies]
ratatui = "0.28"
crossterm = "0.28"
walkdir = "2"
clap = { version = "4", features = ["derive"] }
anyhow = "1"
once_cell = "1"

[[bin]]
name = "rustdu"
path = "src/main.rs"